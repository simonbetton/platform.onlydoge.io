{
  "name": "onlydoge",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/platform",
    "packages/shared-kernel",
    "packages/modules/*"
  ],
  "scripts": {
    "start": "bun run apps/onlydoge/src/index.ts",
    "dev": "bun run apps/onlydoge/src/index.ts",
    "dev:both": "bun run apps/onlydoge/src/index.ts --mode=both",
    "dev:http": "bun run apps/onlydoge/src/index.ts --mode=http",
    "dev:indexer": "bun run apps/onlydoge/src/index.ts --mode=indexer",
    "health:indexer": "bun run scripts/indexer-health.ts",
    "clickhouse:migrate": "bun run scripts/clickhouse-migrate.ts",
    "clickhouse:migrate:status": "bun run scripts/clickhouse-migrate.ts status",
    "metadata:migrations:status": "bun run scripts/metadata-migrations-status.ts",
    "backfill:analytics-transactions": "bun run scripts/backfill-analytics-transaction-facts.ts",
    "test": "vitest run --exclude 'tests/adapters/**'",
    "test:adapters": "env ONLYDOGE_RUN_ADAPTER_TESTS=1 ONLYDOGE_RUN_CLICKHOUSE_SMOKE=1 vitest run tests/adapters tests/integration/clickhouse-analytics-smoke.test.ts --testTimeout=180000",
    "test:clickhouse-smoke": "env ONLYDOGE_RUN_CLICKHOUSE_SMOKE=1 vitest run tests/integration/clickhouse-analytics-smoke.test.ts --testTimeout=180000",
    "test:watch": "vitest",
    "e2e:production": "env ONLYDOGE_RUN_PRODUCTION_E2E=1 vitest run tests/e2e/production.test.ts --testTimeout=180000",
    "e2e:production:deploy": "bun run deploy:production",
    "lint": "biome check .",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "format": "biome format --write .",
    "ci": "bun run lint && bun run typecheck && bun run test",
    "audit:production": "bun audit --audit-level=high --ignore GHSA-fx2h-pf6j-xcff --ignore GHSA-v2wj-q39q-566r --ignore GHSA-p9ff-h696-f583",
    "docker:local:up": "docker compose --env-file .env.local -f docker-compose.local.yml up --build",
    "docker:local:down": "docker compose --env-file .env.local -f docker-compose.local.yml down --remove-orphans",
    "docker:local:reset": "docker compose --env-file .env.local -f docker-compose.local.yml down -v --remove-orphans",
    "docker:local:logs": "docker compose --env-file .env.local -f docker-compose.local.yml logs -f",
    "docker:prod:up": "docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose --env-file .env.production -f docker-compose.prod.yml down --remove-orphans",
    "docker:prod:logs": "docker compose --env-file .env.production -f docker-compose.prod.yml logs -f",
    "image:builder:init": "sh ./scripts/push-image.sh --init-only",
    "image:push": "sh ./scripts/push-image.sh",
    "deploy:docker": "bun run scripts/deploy-docker.ts",
    "deploy:production": "bun run scripts/deploy-production.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1063.0",
    "@clickhouse/client": "1.20.0",
    "@elysiajs/openapi": "1.4.15",
    "@libsql/client": "0.17.4",
    "commander": "15.0.0",
    "dotenv": "17.4.2",
    "elysia": "1.4.28",
    "mysql2": "3.22.5",
    "node-sql-parser": "5.4.0",
    "pg": "8.21.0",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@onlydoge/access-control": "workspace:*",
    "@onlydoge/analytics-query": "workspace:*",
    "@onlydoge/api": "workspace:*",
    "@onlydoge/indexing-pipeline": "workspace:*",
    "@onlydoge/platform": "workspace:*",
    "@onlydoge/shared-kernel": "workspace:*",
    "@types/pg": "^8.20.0",
    "bun-types": "1.3.14",
    "fallow": "^2.89.0",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "overrides": {
    "ws": "8.21.1"
  }
}
