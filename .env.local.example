COMPOSE_PROJECT_NAME=onlydoge-local
# Dogecoin is large but tolerates an external bind mount. Keep Postgres, MinIO,
# and ClickHouse on Docker-managed volumes: macOS bind mounts can stall their
# small-file/database workloads and make the Docker VM unresponsive.
# ONLYDOGE_DATA_DOGECOIN=/Volumes/HDD1/Work/onlydoge/dogecoin
ONLYDOGE_HTTP_PORT=2277
POSTGRES_DB=onlydoge
POSTGRES_USER=onlydoge
POSTGRES_PASSWORD=onlydoge
MINIO_ROOT_USER=onlydoge
MINIO_ROOT_PASSWORD=onlydoge123
MINIO_BUCKET=onlydoge-raw
MINIO_PREFIX=storage
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=onlydoge
CLICKHOUSE_USER=onlydoge
CLICKHOUSE_PASSWORD=onlydoge
CLICKHOUSE_ANALYTICS_USER=onlydoge_analytics
CLICKHOUSE_ANALYTICS_PASSWORD=onlydoge_analytics
ONLYDOGE_INDEXER_SYNC_WINDOW=128
ONLYDOGE_INDEXER_SYNC_CONCURRENCY=4
ONLYDOGE_INDEXER_LEASE_HEARTBEAT_INTERVAL_MS=5000
ONLYDOGE_CORE_BLOCK_TIMEOUT_MS=120000
ONLYDOGE_CORE_DB_STATEMENT_TIMEOUT_MS=30000
ONLYDOGE_CORE_SYNC_COMPLETE_DISTANCE=6
ONLYDOGE_CORE_PROCESS_LOAD_CONCURRENCY=8
ONLYDOGE_CORE_PROCESS_WINDOW=100
ONLYDOGE_CORE_PROGRESS_WATCHDOG_MS=180000
ONLYDOGE_CORE_RAW_STORAGE_TIMEOUT_MS=30000
ONLYDOGE_CORE_ONLINE_TIP_DISTANCE=6
ONLYDOGE_WAREHOUSE_REQUEST_TIMEOUT_MS=30000
ONLYDOGE_ANALYTICS_WAREHOUSE_USER=onlydoge_analytics
ONLYDOGE_ANALYTICS_WAREHOUSE_PASSWORD=onlydoge_analytics
DOGECOIN_UACOMMENT=OnlyDoge
DOGECOIN_RPC_USER=gigawallet
DOGECOIN_RPC_PASSWORD=gigawallet
DOGECOIN_RPC_PORT=22555
DOGECOIN_P2P_PORT=22556
DOGECOIN_ZMQ_PORT=28332
DOGECOIN_RPC_WORKQUEUE=128
ONLYDOGE_DOGECOIN_RPC_ENDPOINT=http://gigawallet:gigawallet@dogecoin:22555/
ONLYDOGE_DOGECOIN_RPC_RPS=32
ONLYDOGE_DOGECOIN_ZMQ_BLOCK_ENDPOINT=tcp://dogecoin:28332
ONLYDOGE_DOGECOIN_ZMQ_TX_ENDPOINT=tcp://dogecoin:28332
