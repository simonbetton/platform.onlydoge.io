ONLYDOGE_IMAGE=ghcr.io/your-org/onlydoge-indexer:latest
ONLYDOGE_PUBLIC_HOST=api.example.com
ONLYDOGE_REMOTE_DIR=/opt/onlydoge
ONLYDOGE_SSH_TARGET=root@10.0.0.10
ONLYDOGE_SSH_JUMP=root@203.0.113.10

ONLYDOGE_DATABASE=postgres://onlydoge:replace-with-a-db-password@postgres.internal.example.com:25060/onlydoge?sslmode=verify-full
ONLYDOGE_DATABASE_SSLROOTCERT_PEM=replace-with-digitalocean-ca-pem
ONLYDOGE_STORAGE=https://sfo3.digitaloceanspaces.com/your-spaces-bucket/storage
ONLYDOGE_S3_ACCESS_KEY_ID=replace-with-a-spaces-access-key
ONLYDOGE_S3_SECRET_ACCESS_KEY=replace-with-a-spaces-secret
ONLYDOGE_WAREHOUSE=http://clickhouse.internal.example.com:8123?database=onlydoge
ONLYDOGE_WAREHOUSE_USER=default
ONLYDOGE_WAREHOUSE_PASSWORD=replace-with-a-clickhouse-password
ONLYDOGE_ANALYTICS_WAREHOUSE_USER=onlydoge_analytics
ONLYDOGE_ANALYTICS_WAREHOUSE_PASSWORD=replace-with-a-clickhouse-analytics-password
ONLYDOGE_WAREHOUSE_REQUEST_TIMEOUT_MS=30000
ONLYDOGE_DOGECOIN_RPC_ENDPOINT=http://rpc-user:rpc-password@dogecoin-rpc.internal.example.com:22555/
ONLYDOGE_DOGECOIN_RPC_RPS=25

ONLYDOGE_INDEXER_SYNC_WINDOW=32
ONLYDOGE_INDEXER_SYNC_CONCURRENCY=4
ONLYDOGE_CORE_BLOCK_TIMEOUT_MS=120000
ONLYDOGE_CORE_DB_STATEMENT_TIMEOUT_MS=30000
ONLYDOGE_CORE_SYNC_COMPLETE_DISTANCE=6
ONLYDOGE_CORE_PROCESS_LOAD_CONCURRENCY=8
ONLYDOGE_CORE_PROCESS_WINDOW=100
ONLYDOGE_CORE_PROGRESS_WATCHDOG_MS=180000
ONLYDOGE_CORE_RAW_STORAGE_TIMEOUT_MS=30000
ONLYDOGE_CORE_ONLINE_TIP_DISTANCE=6
