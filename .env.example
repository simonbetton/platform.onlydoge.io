# OnlyDoge Docker Compose settings. Everything here is optional: docker-compose.yml
# ships the same defaults. Copy to `.env` (self-hosted, `docker compose up -d`) or
# `.env.local` (development, `bun run docker:local:up`) and change what you need.
# Real env files are gitignored; never commit them.

COMPOSE_PROJECT_NAME=onlydoge

# --- Ports published on the host ------------------------------------------------
ONLYDOGE_HTTP_PORT=2277
DOGECOIN_P2P_PORT=22556
# Local override only (docker-compose.local.yml):
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
CLICKHOUSE_HTTP_PORT=8123
DOGECOIN_RPC_PORT=22555
DOGECOIN_ZMQ_PORT=28332

# --- Infrastructure credentials (change for anything internet-facing) ------------
POSTGRES_DB=onlydoge
POSTGRES_USER=onlydoge
POSTGRES_PASSWORD=onlydoge
MINIO_ROOT_USER=onlydoge
MINIO_ROOT_PASSWORD=onlydoge123
MINIO_BUCKET=onlydoge-raw
MINIO_PREFIX=storage
# MinIO background scanner speed (fastest|fast|default|slow|slowest). Raw storage
# needs none of what it does; anything faster only competes with the indexer.
MINIO_SCANNER_SPEED=slowest
CLICKHOUSE_DB=onlydoge
CLICKHOUSE_USER=onlydoge
CLICKHOUSE_PASSWORD=onlydoge
CLICKHOUSE_ANALYTICS_USER=onlydoge_analytics
CLICKHOUSE_ANALYTICS_PASSWORD=onlydoge_analytics
# Container memory ceiling for ClickHouse (Docker units). The checked-in server
# profile budgets 70% of this for tracked allocations.
CLICKHOUSE_MEMORY_LIMIT=20g

# --- Dogecoin Core (docker/dogecoin image) --------------------------------------
# Chain data is ~250 GB. Leave ONLYDOGE_DATA_DOGECOIN unset for a Docker-managed
# volume, or point it at an absolute path on an SSD. Spinning USB disks and macOS
# bind mounts make node RPC slow enough to bottleneck the indexer.
# ONLYDOGE_DATA_DOGECOIN=/Volumes/SSD/onlydoge/dogecoin
DOGECOIN_UACOMMENT=OnlyDoge
DOGECOIN_RPC_USER=onlydoge
DOGECOIN_RPC_PASSWORD=onlydoge
DOGECOIN_RPC_THREADS=8
DOGECOIN_RPC_WORKQUEUE=256
DOGECOIN_DBCACHE=2048
DOGECOIN_MAX_CONNECTIONS=64
# DOGECOIN_EXTRA_ARGS=-par=4

# --- Indexer -> node -------------------------------------------------------------
# Defaults target the bundled `dogecoin` service. For an external node set the
# endpoints here and start with `docker compose up -d --scale dogecoin=0`.
# ONLYDOGE_DOGECOIN_RPC_ENDPOINT=http://rpc-user:rpc-password@dogecoin.internal:22555/
# ONLYDOGE_DOGECOIN_ZMQ_BLOCK_ENDPOINT=tcp://dogecoin.internal:28332
# ONLYDOGE_DOGECOIN_ZMQ_TX_ENDPOINT=tcp://dogecoin.internal:28332
ONLYDOGE_DOGECOIN_RPC_RPS=100
ONLYDOGE_DOGECOIN_RPC_TIMEOUT_MS=60000

# --- Indexer tuning --------------------------------------------------------------
# Raw sync fetches SYNC_BATCH_SIZE blocks per JSON-RPC batch with up to
# SYNC_CONCURRENCY batches in flight; concurrency backs off automatically when the
# node is slow and progress is checkpointed every round, so large windows are safe.
ONLYDOGE_INDEXER_SYNC_WINDOW=256
ONLYDOGE_INDEXER_SYNC_BATCH_SIZE=16
ONLYDOGE_INDEXER_SYNC_CONCURRENCY=8
ONLYDOGE_INDEXER_SYNC_RETRY_ATTEMPTS=6
ONLYDOGE_INDEXER_SYNC_RETRY_BASE_DELAY_MS=500
ONLYDOGE_INDEXER_LEASE_HEARTBEAT_INTERVAL_MS=5000
ONLYDOGE_CORE_BLOCK_TIMEOUT_MS=120000
ONLYDOGE_CORE_DB_STATEMENT_TIMEOUT_MS=30000
ONLYDOGE_CORE_SYNC_COMPLETE_DISTANCE=6
ONLYDOGE_CORE_PROCESS_LOAD_CONCURRENCY=8
ONLYDOGE_CORE_PROCESS_WINDOW=100
ONLYDOGE_CORE_PROGRESS_WATCHDOG_MS=180000
ONLYDOGE_CORE_RAW_STORAGE_TIMEOUT_MS=30000
ONLYDOGE_CORE_REPROCESS_DEPTH=10
ONLYDOGE_CORE_ONLINE_TIP_DISTANCE=6
ONLYDOGE_MEMPOOL_SAMPLE_INTERVAL_MS=15000
ONLYDOGE_MEMPOOL_RETENTION_SECONDS=3600
ONLYDOGE_WAREHOUSE_REQUEST_TIMEOUT_MS=30000
ONLYDOGE_AUDIT_RETENTION_DAYS=365

# --- Slow or shared disks ----------------------------------------------------------
# When Postgres/ClickHouse/MinIO data sits on a spinning or heavily shared disk, a
# single warehouse write can stall for tens of seconds behind a merge. Give the
# indexer room instead of letting it time out and replay the window:
# ONLYDOGE_CORE_DB_STATEMENT_TIMEOUT_MS=120000
# ONLYDOGE_WAREHOUSE_REQUEST_TIMEOUT_MS=120000
# ONLYDOGE_CORE_BLOCK_TIMEOUT_MS=300000
# ONLYDOGE_CORE_PROGRESS_WATCHDOG_MS=600000
