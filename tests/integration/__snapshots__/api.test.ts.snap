      "get": {
        "description": "Opens a one-shot SSE session for a single Dogecoin receive address. Emits mempool.watch.appeared on the first matching mempool output (or catch-up hit), otherwise mempool.watch.timeout after five minutes. Up to five concurrent sessions per API key.",
        "operationId": "getV1ExplorerMempoolWatch",
