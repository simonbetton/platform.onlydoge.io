    "securitySchemes": {
      "ApiTokenAuth": {
        "description": "OnlyDoge API token returned once by \`POST /v1/keys\`. The first key can be created without authentication; subsequent protected requests require this header.",
        "in": "header",
        "name": "x-api-token",
        "type": "apiKey",
      },
    },
  },
  "info": {
    "description": "Dogecoin-first investigation and explorer API. Use \`/v1/keys\` to bootstrap an API token, then send it in the \`x-api-token\` header for protected \`/v1\` routes.",
