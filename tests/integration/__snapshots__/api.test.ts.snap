      "post": {
        "description": "Registers a Dogecoin network for indexing. The RPC endpoint is health-checked before the network is saved.",
        "operationId": "postV1Networks",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "architecture": {
                    "const": "dogecoin",
                    "description": "Network family. Only Dogecoin is currently supported.",
                    "type": "string",
                  },
                  "blockTime": {
                    "description": "Expected block interval in seconds.",
                    "examples": [
                      60,
                    ],
                    "type": "number",
                  },
                  "chainId": {
                    "description": "Chain id namespace for this network.",
                    "examples": [
                      0,
                    ],
                    "type": "number",
                  },
                  "id": {
                    "description": "Optional network id. If omitted, OnlyDoge generates a \`net_\` id.",
                    "examples": [
                      "net_dogecoin",
                    ],
                    "type": "string",
                  },
                  "name": {
                    "description": "Human-readable network name.",
                    "examples": [
                      "Dogecoin Mainnet",
                    ],
                    "type": "string",
                  },
                  "rpcEndpoint": {
                    "description": "Dogecoin Core JSON-RPC endpoint. Credentials are accepted in the URL but are masked in responses and logs.",
                    "examples": [
                      "https://user:pass@doge.example/rpc",
                    ],
                    "type": "string",
                  },
                  "rps": {
                    "description": "RPC request-per-second budget for indexing work.",
                    "examples": [
                      100,
                    ],
                    "type": "number",
                  },
                  "zmqBlockEndpoint": {
                    "anyOf": [
                      {
                        "description": "Optional Dogecoin Core ZMQ block endpoint.",
                        "examples": [
                          "tcp://127.0.0.1:28332",
                        ],
                        "type": "string",
                      },
                      {
                        "type": "null",
                      },
                    ],
                    "nullable": true,
                  },
                },
                "required": [
                  "name",
                  "architecture",
                  "blockTime",
                  "rpcEndpoint",
