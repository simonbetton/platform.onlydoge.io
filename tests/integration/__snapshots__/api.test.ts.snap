                      "key_operator",
                    ],
                    "type": "string",
                  },
                  "role": {
                    "enum": [
                      "admin",
                      "member",
                    ],
                    "type": "string",
                  },
                },
                "type": "object",
              },
            },
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "id": {
