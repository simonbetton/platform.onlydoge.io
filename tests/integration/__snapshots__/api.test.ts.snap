    "/v1/audit/events": {
      "get": {
        "description": "Lists audit events. Admin API keys can read all events; member API keys can read only their own actor events.",
        "operationId": "getV1AuditEvents",
        "parameters": [
          {
            "in": "query",
            "name": "actor",
            "required": false,
            "schema": {
              "description": "Actor API key id.",
              "examples": [
                "key_operator",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "description": "Inclusive lower bound for event creation time as ISO-8601.",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "description": "Exclusive upper bound for event creation time as ISO-8601.",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "method",
            "required": false,
            "schema": {
              "description": "HTTP method.",
              "examples": [
                "POST",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "outcome",
            "required": false,
            "schema": {
              "enum": [
                "success",
                "failure",
                "denied",
                "rate_limited",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "resourceId",
            "required": false,
            "schema": {
              "description": "Resource id recorded for the request.",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "resourceType",
            "required": false,
            "schema": {
              "description": "Resource type recorded for the request.",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "statusCode",
            "required": false,
            "schema": {
              "description": "HTTP status code.",
              "examples": [
                "403",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "description": "Zero-based number of records to skip. Maximum 100000.",
              "examples": [
                "0",
                "25",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "description": "Maximum number of records to return. Defaults to 50; maximum 500. Values above the maximum return a validation error.",
              "examples": [
                "25",
                "100",
              ],
              "type": "string",
            },
          },
        ],
        "security": [
          {
            "ApiTokenAuth": [],
          },
        ],
        "summary": "List audit events",
        "tags": [
          "Access Control",
        ],
      },
    },
