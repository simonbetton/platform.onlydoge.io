                  },
                },
                "required": [
                  "keys",
                ],
                "type": "object",
              },
            },
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "keys": {
                    "description": "API key ids to delete.",
                    "items": {
                      "description": "API key id.",
                      "examples": [
                        "key_operator",
                      ],
                      "type": "string",
                    },
